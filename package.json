{
  "name": "cypress-toolshop-e2e",
  "version": "1.0.0",
  "description": "Cypress + TypeScript E2E suite for practicesoftwaretesting.com (Toolshop v5.0).",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "cy:open": "cypress open --e2e --browser chrome",
    "test": "cypress run",
    "test:ci": "cypress run --browser chrome",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:auth": "cypress run --spec 'cypress/e2e/auth/**/*.cy.ts'",
    "test:catalog": "cypress run --spec 'cypress/e2e/catalog/**/*.cy.ts'",
    "test:buying": "cypress run --spec 'cypress/e2e/buying/**/*.cy.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.cjs",
    "lint:fix": "eslint . --ext .ts,.cjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf cypress/reports cypress/screenshots cypress/videos"
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.0",
    "@faker-js/faker": "^10.4.0",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cypress": "^15.16.0",
    "cypress-multi-reporters": "^2.0.5",
    "eslint": "^10.4.0",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-mocha": "^11.3.0",
    "mocha-junit-reporter": "^2.2.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
